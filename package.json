    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.2",
    "vite": "^8.2.0"
